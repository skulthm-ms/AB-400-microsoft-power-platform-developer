# Foundry project endpoint, from the project Overview page
# (Format: https://<resource-name>.services.ai.azure.com/api/projects/<project-name>)
PROJECT_ENDPOINT="your_project_endpoint"

# The deployment name of the model you deployed in the Foundry project
MODEL_DEPLOYMENT="gpt-4.1"

# The Dataverse MCP server URL for your environment
# (Format: https://<org-name>.crm.dynamics.com/api/mcp)
DATAVERSE_MCP_URL="your_dataverse_mcp_url"

# The name of the project connection you created for the Dataverse MCP server
MCP_CONNECTION_NAME="ab400-lab10-dataverse-mcp"
