# The Environment ID of the environment that holds the Copilot Studio agent
# (Settings > Advanced > Metadata, in Copilot Studio)
COPILOTSTUDIOAGENT__ENVIRONMENTID="your_environment_id"

# The agent's schema name (Settings > Advanced > Metadata, in Copilot Studio)
COPILOTSTUDIOAGENT__SCHEMANAME="your_agent_schema_name"

# The Directory (tenant) ID of the app registration you created
COPILOTSTUDIOAGENT__TENANTID="your_tenant_id"

# The Application (client) ID of the ab400-lab10-client app registration
COPILOTSTUDIOAGENT__AGENTAPPID="your_app_client_id"
